{
  "output_dir": "outputs/train/hilserl_grab_tube",
  "job_name": "hilserl_grab_tube",
  "seed": 1000,
  "num_workers": 4,
  "batch_size": 128,
  "steps": 200000,
  "log_freq": 100,
  "save_freq": 500,
  "save_checkpoint": true,
  "online_ratio": 0.5,
  "mixer": "online_offline",
  "wandb": {
    "enable": false
  },
  "dataset": {
    "repo_id": "Atomictan/grab_tube_offline_10hz_v3"
  },
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "fps": 10,
    "task": "Grab the tube",
    "robot": {
      "type": "so101_follower",
      "port": "/dev/lerobot_follower",
      "id": "my_awesome_follower_arm",
      "cameras": {
        "wrist": {
          "type": "opencv",
          "index_or_path": "/dev/lerobot_wrist_cam",
          "width": 480,
          "height": 640,
          "fps": 30,
          "rotation": 90
        },
        "side": {
          "type": "opencv",
          "index_or_path": "/dev/lerobot_side_cam",
          "width": 640,
          "height": 480,
          "fps": 30
        }
      }
    },
    "teleop": {
      "type": "keyboard_ee"
    },
    "processor": {
      "observation": {
        "add_ee_pose_to_observation": false,
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.side": [
            0,
            0,
            440,
            300
          ]
        },
        "resize_size": [
          128,
          128
        ]
      },
      "inverse_kinematics": {
        "urdf_path": "/home/atomic/robot_assets/so101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [
            0.02,
            -0.23,
            -0.03
          ],
          "max": [
            0.2,
            -0.03,
            0.08
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.02,
          "y": 0.02,
          "z": 0.02
        }
      },
      "max_gripper_pos": 40.0,
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": [
          57.0,
          -12.4,
          15.9,
          84.2,
          -1.8,
          30.0
        ],
        "reset_time_s": 15.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "reward_classifier": {
        "pretrained_path": "outputs/train/reward_classifier_v2/checkpoints/005720/pretrained_model",
        "success_threshold": 0.7,
        "success_reward": 1.0
      }
    },
    "features": {
      "action": {
        "type": "ACTION",
        "shape": [
          4
        ]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [
          6
        ]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [
          128,
          128,
          3
        ]
      },
      "observation.images.side": {
        "type": "VISUAL",
        "shape": [
          128,
          128,
          3
        ]
      }
    },
    "features_map": {
      "action": "action",
      "observation.state": "observation.state",
      "observation.images.wrist": "observation.images.wrist",
      "observation.images.side": "observation.images.side"
    }
  },
  "policy": {
    "type": "gaussian_actor",
    "device": "cuda",
    "storage_device": "cpu",
    "online_buffer_capacity": 50000,
    "offline_buffer_capacity": 3000,
    "online_step_before_learning": 500,
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 2
    },
    "push_to_hub": false,
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          6
        ]
      },
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.side": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          4
        ]
      }
    },
    "dataset_stats": {
      "observation.state": {
        "min": [
          0.7,
          -101.9,
          -79.5,
          20.5,
          -75.1,
          -3.2
        ],
        "max": [
          111.2,
          86.7,
          116.1,
          117.2,
          82.7,
          48.0
        ]
      },
      "action": {
        "min": [
          -1.0,
          -1.0,
          -1.0,
          0.0
        ],
        "max": [
          1.0,
          1.0,
          1.0,
          2.0
        ]
      },
      "observation.image": {
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ]
      }
    },
    "vision_encoder_name": "lerobot/resnet10",
    "freeze_vision_encoder": true
  },
  "algorithm": {
    "type": "sac",
    "discount": 0.99,
    "utd_ratio": 1,
    "policy_update_freq": 1
  },
  "save_checkpoint_to_hub": false
}
